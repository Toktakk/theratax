// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PracticeType {
  mobile
  fixedLocation
  mixed
}

enum ExpenseMethod {
  flat_rate
  actual_cost
}

enum TransactionType {
  income
  expense
}

enum MassageType {
  deep_tissue
  thai_oil
  thai_yoga
  aroma
  pregnancy
  lymphatic
  foot
  swedish
  back_neck
  sport
  hot_stone
  body_scrub
  request
  other
}

enum ExpenseCategoryKind {
  general
  mileage
  vehicle_actual
}

enum InvoiceStatus {
  issued
  paid
}

enum WorkplaceKind {
  spa
  clinic
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  name          String
  practiceType  PracticeType?
  expenseMethod ExpenseMethod?
  onboardedAt   DateTime?
  addressLine1  String?
  addressLine2  String?
  town          String?
  postcode      String?
  sessions      Session[]
  transactions  Transaction[]
  invoices      Invoice[]
  workplaces    Workplace[]
  clients       Client[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  slug         String              @id
  name         String
  keywords     String[]
  kind         ExpenseCategoryKind
  transactions Transaction[]
}

model Transaction {
  id                 Int              @id @default(autoincrement())
  type               TransactionType
  occurredOn         DateTime         @db.Date
  amountPence        Int
  note               String?
  miles              Int?
  massageType        MassageType?
  customMassageType  String?
  basePence          Int?
  additionalFeePence Int?
  bonusPence         Int?
  minutes            Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  userId             Int
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categorySlug       String?
  category           ExpenseCategory? @relation(fields: [categorySlug], references: [slug])
  workplaceId        Int?
  workplace          Workplace?       @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  clientId           Int?
  client             Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceId          Int?             @unique
  invoice            Invoice?         @relation(fields: [invoiceId], references: [id])
  invoiceLines       InvoiceLine[]
  receipt            Receipt?

  @@index([userId, occurredOn])
}

model Receipt {
  transactionId Int         @id
  contentType   String
  byteSize      Int
  storageKey    String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            Int                   @id @default(autoincrement())
  number        String                @unique
  clientName    String?
  service       String?
  amountPence   Int
  issuedOn      DateTime              @db.Date
  status        InvoiceStatus         @default(issued)
  paidOn        DateTime?             @db.Date
  recipientKind InvoiceRecipientKind?
  recipientName String?
  workplaceId   Int?
  clientId      Int?
  period        InvoicePeriod?
  periodStart   DateTime?             @db.Date
  periodEnd     DateTime?             @db.Date
  supplierAddressLine1  String?
  supplierAddressLine2  String?
  supplierTown          String?
  supplierPostcode      String?
  recipientAddressLine1 String?
  recipientAddressLine2 String?
  recipientTown         String?
  recipientPostcode     String?
  userId        Int
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workplace     Workplace?            @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  client        Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transaction   Transaction?
  lines         InvoiceLine[]

  @@index([userId])
}

model Workplace {
  id            Int           @id @default(autoincrement())
  name          String        @db.Citext
  kind          WorkplaceKind
  hourRatePence Int           @default(0)
  addressLine1  String?
  addressLine2  String?
  town          String?
  postcode      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  invoices      Invoice[]
  hourExtras    HourExtra[]

  @@unique([userId, kind, name])
  @@index([userId])
}

model HourExtra {
  id                Int         @id @default(autoincrement())
  massageType       MassageType
  customMassageType String?
  extraPence        Int
  workplaceId       Int?
  clientId          Int?
  workplace         Workplace?  @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  client            Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workplaceId])
  @@index([clientId])
}

enum InvoiceRecipientKind {
  spa
  clinic
  client
}

enum InvoicePeriod {
  day
  month
}

enum InvoiceLineKind {
  service
  additional_fee
  hourly_bonus
  bonus
}

enum QuantityUnit {
  session
  minute
}

model Client {
  id            Int           @id @default(autoincrement())
  name          String        @db.Citext
  hourRatePence Int           @default(0)
  addressLine1  String?
  addressLine2  String?
  town          String?
  postcode      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  invoices      Invoice[]
  hourExtras    HourExtra[]

  @@unique([userId, name])
  @@index([userId])
}

model InvoiceLine {
  id                  Int             @id @default(autoincrement())
  kind                InvoiceLineKind
  description         String
  quantity            Int
  quantityUnit        QuantityUnit
  ratePence           Int
  amountPence         Int
  occurredOn          DateTime        @db.Date
  sourceTransactionId Int?
  invoiceId           Int
  invoice             Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceTransaction   Transaction?    @relation(fields: [sourceTransactionId], references: [id], onDelete: SetNull)

  @@unique([sourceTransactionId, kind])
}
